# =============================================================================
# Crescor Bilvård — environment variables (frontend, build time)
# Copy to `.env.local` for local development or set them in your hosting
# provider's build settings. NEVER put secret keys in VITE_* variables: every
# VITE_* value is embedded in the public JavaScript bundle.
# =============================================================================

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_…) or legacy "anon" key.
# Safe to expose: access is limited by Row Level Security and function grants.
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Public website address, used for canonical URLs, Open Graph and sitemap.xml
VITE_SITE_URL=https://www.example.se

# Optional: Cloudflare Turnstile site key (public). Set together with the
# TURNSTILE_SECRET_KEY Edge Function secret, or leave both empty.
VITE_TURNSTILE_SITE_KEY=

# =============================================================================
# Edge Function secrets — set with `supabase secrets set NAME=value`.
# Listed here for reference only; they do NOT belong in this file or in git.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
# =============================================================================
# ALLOWED_ORIGINS=https://www.example.se,https://example.se
# SITE_URL=https://www.example.se        (shows the logo in e-mails)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Crescor Bilvård <bokning@example.se>
# TURNSTILE_SECRET_KEY=
# HEALTH_CHECK_TOKEN=<long random string, also stored as a GitHub secret>
# RATE_LIMIT_SALT=<long random string>
# BOOKING_RATE_LIMIT_PER_HOUR=10
# CONTACT_RATE_LIMIT_PER_HOUR=5
